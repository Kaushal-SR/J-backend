generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
///  * Hiragana characters
///  * Example: あ, い, う
model Hiragana {
  id          String   @id @default(uuid())
  symbol      String   @unique
  romaji      String
  explanation String
  example     String?
  imageUrl    String?
  audioUrl    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// *
///  * Katakana characters
///  * Example: ア, イ, ウ
model Katakana {
  id          String   @id @default(uuid())
  symbol      String   @unique
  romaji      String
  explanation String
  example     String?
  imageUrl    String?
  audioUrl    String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model User {
  id         String         @id @default(uuid())
  email      String         @unique
  password   String
  role       Role           @default(USER)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  progresses UserProgress[]
}

/// Tracks user progress for kana, kanji, vocab
model UserProgress {
  id         String       @id @default(uuid())
  userId     String
  itemId     String
  itemType   ProgressType
  learned    Boolean      @default(false)
  bookmarked Boolean      @default(false)
  quizScore  Int?
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id])

  @@unique([userId, itemId, itemType])
}

/// *
///  * Vocabulary words (JLPT based)
model Vocabulary {
  id        String   @id @default(uuid())
  word      String
  meaning   String
  furigana  String
  romaji    String?
  level     Int
  description String?
  createdAt DateTime @default(now())

  @@unique([word, furigana])
}

enum Role {
  ADMIN
  USER
}

enum ProgressType {
  HIRAGANA
  KATAKANA
  KANJI
  VOCAB
  GRAMMAR
}

/// *
///  * Kanji characters (JLPT based)
model Kanji {
  id           String   @id @default(uuid())
  character    String   @unique
  meaning      String
  onyomi       String[]
  kunyomi      String[]
  strokes      Int
  jlptLevel    String
  radicals     String[]
  status       String?
  reviewCount  Int?
  isBookmarked Boolean  @default(false)
  examples     Json?
  createdAt    DateTime @default(now())
}

/// *
///  * Grammar points (JLPT based)
model Grammar {
  id             String   @id @default(uuid())
  grammarPoint   String   // Name of the grammar point (e.g., 〜なければならない)
  reading        String?  // Reading of the grammar point
  jlptLevel      String   // e.g., "N3", "N4", "N5", "N4_N5"
  structure      String?  // Typical sentence pattern / formation
  meaning        String   // Short English meaning
  nuance         String?  // Nuance / notes
  formality      String?  // Formality level (Polite, Neutral, Casual, etc.)
  category       String?  // Semantic category (Time, Condition, etc.)
  similarGrammar String?  // Similar grammar patterns
  attachesTo     String?  // What this grammar attaches to
  examples       Json?    // Example sentences and readings
  familiarity    Int?     // Familiarity (1-5)
  status         String?  // Custom status / learning status
  lastReviewed   DateTime?
  personalNotes  String?
  createdAt      DateTime @default(now())
}
